{
  "name": "graded-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "tsc && vite build",
    "start": "node server/index.js --prod",
    "check": "tsc --noEmit",
    "test:unit": "node scripts/test-units.mjs",
    "test:server": "node scripts/test-server-regression.mjs",
    "test:ai": "node scripts/test-ai-config.mjs && node scripts/test-ai-config-form.mjs && node scripts/test-custom-ai-endpoint.mjs",
    "analyze:server": "node scripts/analyze-server-deps.mjs",
    "check:symbols": "node scripts/check-server-symbols.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "visual": "node scripts/visual-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "predeploy": "node scripts/predeploy-check.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:drill": "node scripts/backup-drill.mjs",
    "restore": "node scripts/restore.mjs",
    "verify": "npm run check && npm run check:symbols && npm run check:imports && npm run check:routes && npm run test:unit && npm run test:ai && npm run test:server",
    "check:imports": "node scripts/check-server-imports.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "measure:storage": "node scripts/measure-storage.mjs",
    "compare:models": "node scripts/compare-models.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.9.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "multer": "^2.2.0",
    "nanoid": "^5.1.16",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {}
}
